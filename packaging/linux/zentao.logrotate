/opt/zentao/logs/php-error.log {
    weekly
    rotate 5
    maxsize 32M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}

/opt/zentao/logs/mysql.log {
    weekly
    rotate 4
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
